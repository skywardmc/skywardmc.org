---
import Layout from "../layouts/Layout.astro";
import Search from "astro-pagefind/components/Search.astro";
---

<Layout title="Find" description="Search all content of skywardmc.org">
	<div class="prose prose-skywardmc prose-sm dark:prose-invert max-w-full">
		<Search />
		<p class="text-right">
			thanks <a href="https://pagefind.app">pagefind</a> &lt;3
		</p>
	</div>
</Layout>

<style>
	:root {
		--pf-font: var(--font-sans);
		--pf-text: var(--color-skywardmc-offgray);
		--pf-background: var(--color-skywardmc-offwhite);
		--pf-mark: var(--color-skywardmc-blue);
		--pf-outline-focus: var(--color-skywardmc-blue);
		--pf-border: transparent;
		--pf-border-radius: 0.125rem;
		--pf-searchbox-max-width: 100%;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--pf-text: var(--color-skywardmc-offwhite);
			--pf-background: var(--color-skywardmc-offgray);
		}
	}
</style>
